# Copy to .env.local and fill in. Both Supabase values are required for
# persistence; without them the app runs as a local-only scratchpad.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin for this deployment. Drives metadataBase, the canonical
# link, JSON-LD, robots.txt and sitemap.xml. Defaults to
# https://stickynoter.org when unset. Set it on preview deployments so they
# self-reference instead of pointing at production.
# NEXT_PUBLIC_SITE_URL=
